# ScrapingBot -- copie para `.env` e preencha.  INF-2
#
# O .env.example antigo declarava URL, WEBHOOK e WEBHOOK_LOGGINGS enquanto o
# codigo lia URL, P_URL, REFERER, SCRAPINGBOT e LOGGINGSBOT. Quem clonasse o
# repositorio nao conseguia rodar -- e descobria isso via `requests.get(None)`.
# Um .env.example errado e pior que nenhum.
#
# Todas as variaveis abaixo sao validadas no boot: se faltar uma obrigatoria, o
# processo para imediatamente dizendo O NOME dela.

# ============================================================== OBRIGATORIAS
# Endpoint JSON consultado (o que o front-end do alvo chama).
URL=https://loja.exemplo.com.br/api/io/_v/api/intelligent-search/product_search?query=...

# Pagina HTML equivalente. Usada para aquecer a sessao antes do XHR e como link
# no alerta do Discord.  SCR-8 / PRD-2
P_URL=https://loja.exemplo.com.br/categoria

# Referer enviado nas requisicoes -- normalmente igual ao P_URL.
REFERER=https://loja.exemplo.com.br/categoria

# Webhook do canal que o CLIENTE le. So recebe o que exige acao dele.
DISCORD_ALERT_WEBHOOK=https://discord.com/api/webhooks/000/xxx

# Webhook do canal de OPERACAO: heartbeat, falhas, anomalias, manutencao.
DISCORD_LOG_WEBHOOK=https://discord.com/api/webhooks/111/yyy

# ================================================================= OPCIONAIS
# ---- Notificacao -----------------------------------------------------------
# Quem e mencionado no alerta. Vazio = ninguem. Prefira um CARGO opt-in a
# @everyone, que e o caminho mais curto para silenciarem o canal.  SCR-5
#   cargo:   <@&123456789012345678>     usuario: <@123456789012345678>
ALERT_MENTION=

# ---- Regra de negocio ------------------------------------------------------
# Delta minimo para alertar. 1 = avisa a cada produto novo.
# O `if difference > 2` da v1 nao so deixava de notificar aumentos de 1-2 como
# tambem NAO OS PERSISTIA -- e essa e a causa mais provavel da "notificacao
# atrasada" relatada pelo cliente.  BUG-8
ALERT_THRESHOLD=1

# Acima disto a variacao vira ANOMALIA no canal de log em vez de alerta no
# canal publico: um salto de 480 para 50.000 quase nunca e estoque novo, e
# mudanca de contrato da API.  BUG-15
MAX_PLAUSIBLE_DELTA=200
MAX_PLAUSIBLE_AMOUNT=100000

# ---- Cadencia --------------------------------------------------------------
INTERVAL_MIN_S=45
INTERVAL_MAX_S=75
CYCLE_DEADLINE_S=40          # avisa no log quando o ciclo passa disso  BUG-16
BACKOFF_BASE_S=60            # apos falha: 60s, 120s, 240s...  BUG-17
BACKOFF_MAX_S=1800

# Janela de operacao, no fuso de TIMEZONE. Vazio = 24/7.
# O README prometia ter/qui/dom das 8 as 19; o codigo rodava direto. Agora a
# janela vive NO CODIGO -- o container ignora o cron do host.  ARQ-8
#   ACTIVE_DAYS=1,3,6        (0=segunda ... 6=domingo)
ACTIVE_DAYS=
ACTIVE_HOUR_START=0
ACTIVE_HOUR_END=24
TIMEZONE=America/Sao_Paulo

# ---- Coleta / stealth ------------------------------------------------------
# auto = usa curl_cffi se instalado (fingerprint TLS/HTTP2 de Chrome real),
# senao cai para requests. Ver docs/stealth.md.  SCR-6
FETCH_BACKEND=auto

# Visita a pagina HTML antes do XHR, como um usuario faria.  SCR-8
WARMUP_ENABLED=1

# Recria a sessao INTEIRA (cookies + perfil de navegador) a cada N ciclos.
# Trocar so o User-Agent mantendo cookies e sinal de deteccao, nao disfarce.
# SCR-1
SESSION_MAX_CYCLES=40

PREFETCH_DELAY_MIN_S=1.5
PREFETCH_DELAY_MAX_S=3.5
HTTP_TIMEOUT_S=10
HTTP_RETRIES=3
HTTP_BACKOFF_FACTOR=2

# Parametro anti-cache anexado a URL. Vazio desliga. O valor CERTO e o que o
# proprio front-end do alvo usa -- confira no DevTools.
CACHE_BUSTER_PARAM=_

# Cache-Control/Pragma: no-cache em toda requisicao. Desligado por padrao
# porque um Chrome real so envia isso em reload forcado -- e um tell. Ligue
# apenas se o `doctor` mostrar que voce esta lendo cache de borda.
NO_CACHE_HEADERS=0

# ---- Operacao --------------------------------------------------------------
HEARTBEAT_EVERY=15               # heartbeat a cada N ciclos  ARQ-5
FAILURE_ALERT_THRESHOLD=5        # alerta apos N falhas seguidas  OBS-5
STALE_ALERT_THRESHOLD=30         # suspeita apos N respostas identicas  SCR-7

# Dead-man's switch: URL de um servico que alerta pela AUSENCIA do ping
# (healthchecks.io, Cronitor). O heartbeat do Discord e enviado pelo proprio
# bot -- se ele morrer, o sinal nao e um alerta, e silencio. Este e o item de
# maior retorno por linha da auditoria inteira.  REL-1
DEADMAN_URL=

# ---- Banco -----------------------------------------------------------------
# No Docker isto ja vem definido pela imagem. Fora dele, caminho absoluto ou
# relativo. Nao depende mais do diretorio de onde o bot foi chamado.  BUG-5
DB_PATH=data/scrapingbot.db
LOCK_PATH=data/scrapingbot.lock
BACKUP_DIR=data/backups
BACKUP_KEEP=7
RETENTION_DAYS=30                # detalhe de `runs`; o resumo por hora fica  DAT-5
EVENTS_RETENTION_DAYS=730        # eventos sao o historico de negocio

# ---- Log -------------------------------------------------------------------
LOG_LEVEL=INFO
# Vazio = so stdout, que e o certo em container. Preencha so fora do Docker.
LOG_FILE=
LOG_MAX_BYTES=5000000
LOG_BACKUPS=3
